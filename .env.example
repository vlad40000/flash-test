# Standalone benchmark secrets. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Vercel deployment: connect a PRIVATE Vercel Blob store to this project.
# Vercel injects this automatically after the store is connected.
BLOB_READ_WRITE_TOKEN=

# Optional local override. Defaults to filesystem locally and blob on Vercel.
# Allowed values: filesystem | blob
# FLASH_BENCHMARK_STORAGE=filesystem

# Set to 1 only for the disposable two-call live smoke test.
RUN_LIVE_GEMINI_TESTS=0
